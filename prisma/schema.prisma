generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum LeadStatus {
  NEW
  QUEUED
  SENT
  CONTACTED
  FOLLOWUP_1
  FOLLOWUP_2
  REPLIED
  SKIPPED
  BOUNCED
  UNSUBSCRIBED
  WON
  LOST
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  REPLIED
  BOUNCED
  FAILED
}

enum ActivityType {
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_REPLIED
  STATUS_CHANGED
  NOTE_ADDED
  FOLLOWUP_SCHEDULED
  STAGE_MOVED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String          @unique
  password         String
  role             UserRole        @default(USER)
  lastLoginAt      DateTime?
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPass         String?
  fromName         String?
  promoteSite      String?
  promoteTopic     String?
  dailyLimit       Int?            @default(40)
  mapsApiKey       String?
  cseApiKey        String?
  cseCx            String?
  aiEnabled        Boolean?        @default(false)
  aiProvider       String?         @default("deepseek")
  aiModel          String?
  deepseekApiKey   String?
  openaiApiKey     String?
  aiExtraPrompt    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  leads            Lead[]
  campaigns        Campaign[]
  templates        Template[]
  tasks            Task[]
  activities       Activity[]
  gmailAccounts    GmailAccount[]
  scraperSearches  ScraperSearch[]
  adminLogs        AdminLog[]

  @@map("users")
}

model ScraperSearch {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  query         String
  source        String
  city          String?
  niche         String?
  resultsCount  Int       @default(0) @map("results_count")
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("scraper_searches")
}

model AdminLog {
  id          String    @id @default(uuid())
  adminId     String    @map("admin_id")
  action      String
  target      String?
  details     String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@map("admin_logs")
}

model GmailAccount {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  email        String
  accessToken  String    @db.Text @map("access_token")
  refreshToken String    @db.Text @map("refresh_token")
  expiryDate   BigInt?   @map("expiry_date")
  scope        String?   @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  dailyQuota   Int       @default(40) @map("daily_quota")
  sentToday    Int       @default(0) @map("sent_today")
  lastResetAt  DateTime  @default(now()) @map("last_reset_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@map("gmail_accounts")
}

model Lead {
  id               String              @id @default(uuid())
  name             String
  email            String
  phone            String?
  company          String?
  website          String?
  city             String?
  niche            String?
  status           LeadStatus          @default(NEW)
  source           String?             @default("Manual")
  notes            String?             @db.Text
  replyDetectedAt  DateTime?           @map("reply_detected_at")
  bounceReason     String?             @map("bounce_reason")
  lastFollowupAt   DateTime?           @map("last_followup_at")
  followupCount    Int                 @default(0) @map("followup_count")
  userId           String              @map("user_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailsSent       EmailSent[]
  tasks            Task[]
  activities       Activity[]
  followupSequences FollowupSequence[]

  @@index([userId, status])
  @@index([createdAt])
  @@map("leads")
}

model Campaign {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  name            String
  status          CampaignStatus     @default(DRAFT)
  templateId      String?            @map("template_id")
  followupDelay   Int                @default(4) @map("followup_delay_days")
  maxFollowups    Int                @default(2) @map("max_followups")
  dailyLimit      Int                @default(40) @map("daily_limit")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  followupSequences FollowupSequence[]
  emailsSent      EmailSent[]

  @@map("campaigns")
}

model FollowupSequence {
  id           String      @id @default(uuid())
  leadId       String      @map("lead_id")
  campaignId   String      @map("campaign_id")
  stepNumber   Int         @default(1) @map("step_number")
  nextSendDate DateTime    @map("next_send_date")
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  lead         Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign     Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([nextSendDate, status])
  @@map("followup_sequences")
}

model Template {
  id           String       @id @default(uuid())
  name         String
  category     String       @default("Cold Outreach")
  templateType String       @default("initial") @map("template_type")
  aiGenerated  Boolean      @default(false) @map("ai_generated")
  subject      String
  body         String       @db.Text
  userId       String?      @map("user_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailsSent   EmailSent[]

  @@map("templates")
}

model EmailSent {
  id             String       @id @default(uuid())
  leadId         String       @map("lead_id")
  templateId     String?      @map("template_id")
  campaignId     String?      @map("campaign_id")
  userId         String       @map("user_id")
  subject        String
  body           String       @db.Text
  gmailThreadId  String?      @map("gmail_thread_id")
  gmailMessageId String?      @map("gmail_message_id")
  deliveryStatus String?      @map("delivery_status")
  isFollowup     Boolean      @default(false) @map("is_followup")
  followupNumber Int          @default(0) @map("followup_number")
  status         EmailStatus  @default(SENT)
  sentAt         DateTime     @default(now()) @map("sent_at")

  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  template       Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gmailThreadId])
  @@index([sentAt])
  @@map("emails_sent")
}

model Task {
  id          String       @id @default(uuid())
  title       String
  completed   Boolean      @default(false)
  leadId      String?      @map("lead_id")
  dueDate     DateTime?    @map("due_date")
  userId      String       @map("user_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model Activity {
  id          String       @id @default(uuid())
  leadId      String       @map("lead_id")
  type        ActivityType
  description String
  createdAt   DateTime     @default(now()) @map("created_at")

  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("activities")
}